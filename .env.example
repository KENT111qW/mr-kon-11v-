# Скопируй этот файл в .env и заполни своими ключами
# .env не отправляй в git и никому не показывай!

# 1. Токен Telegram-бота — получи у @BotFather в Telegram
#    Напиши @BotFather -> /newbot -> придумай имя и юзернейм -> скопируй токен
TELEGRAM_TOKEN=1234567890:AAH_твой_токен_от_BotFather

# 2. Ключ Google Gemini — бесплатно на https://aistudio.google.com/app/apikey
#    Войди Google-аккаунтом -> Create API key -> скопируй ключ
GEMINI_API_KEY=твой_ключ_Gemini_с_aistudio_google_com
